# syntax=docker/dockerfile:1

# Deploy rápido: mesmo build do Dockerfile, mas refaz o prerender só das rotas alteradas e
# reaproveita o das demais a partir da imagem que está no ar. Leva minutos, não 45.
# Quem dispara é scripts/deploy-rapido.sh. O Dockerfile continua sendo o deploy completo.

FROM wtech-site:prod AS anterior

FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .

# Sem default de propósito: ver a nota no Dockerfile sobre o banco errado.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium-browser

ARG PRERENDER_ROUTES=/
RUN npm run build && PRERENDER_ROUTES="$PRERENDER_ROUTES" npm run prerender

COPY --from=anterior /app/dist /anterior
RUN node scripts/juntar-prerender.mjs /anterior dist && rm -rf /anterior

RUN npm run build:server

FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/dist ./dist
COPY --from=build /app/dist-server ./dist-server

EXPOSE 3000
CMD ["node", "dist-server/index.mjs"]
