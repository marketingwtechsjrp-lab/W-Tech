{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/whatsapp-cloud-webhook.ts": {
      "maxDuration": 60
    },
    "api/notify-students.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/checkout-recovery",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/process-email-flows",
      "schedule": "0 13 * * *"
    }
  ]
}
